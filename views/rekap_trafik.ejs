<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Executive Analytics — dr. Shodiq Kukuh, Sp.OG</title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body { background: #f0f4f8; color: #1e293b; padding: 24px; font-family: 'Plus Jakarta Sans', sans-serif; }
        .executive-header {
            background: linear-gradient(135deg, #0d5c75 0%, #093f51 100%);
            color: white;
            padding: 24px 30px;
            border-radius: 18px;
            margin-bottom: 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 10px 25px rgba(13, 92, 117, 0.2);
        }
        .kpi-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; margin-bottom: 24px; }
        .kpi-card {
            background: white;
            padding: 20px;
            border-radius: 16px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            border: 1px solid #e2e8f0;
            border-top: 4px solid #0d5c75;
        }
        .kpi-card h3 { margin: 0; font-size: 26px; font-weight: 800; color: #0d5c75; }
        .kpi-card p { margin: 4px 0 0 0; color: #64748b; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
        
        .analytics-grid-top { display: grid; grid-template-columns: 2fr 1fr; gap: 20px; margin-bottom: 24px; }
        .analytics-grid-bottom { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px; }
        
        .chart-card {
            background: white;
            padding: 22px;
            border-radius: 16px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            border: 1px solid #e2e8f0;
        }
        .chart-title {
            font-size: 16px;
            font-weight: 800;
            color: #0d5c75;
            margin: 0 0 4px 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .chart-subtitle { font-size: 12px; color: #94a3b8; margin: 0 0 16px 0; }
    </style>
</head>
<body>
    <div class="app-container" style="max-width: 1380px; margin: auto;">
        
        <!-- Header Utama -->
        <div class="executive-header">
            <div>
                <h1 style="margin: 0; font-size: 24px; font-weight: 800;">📊 Executive Analytics & Traffic Dashboard</h1>
                <p style="margin: 4px 0 0 0; opacity: 0.85; font-size: 14px;">Praktek Dokter Spesialis Kandungan — dr. Shodiq Kukuh, Sp.OG (RS Utama Husada)</p>
            </div>
            <div>
                <a href="/" class="btn-reset" style="background: rgba(255,255,255,0.2); color: white; padding: 10px 20px; border-radius: 10px; text-decoration: none; font-weight: 700;">⬅ Kembali ke Beranda</a>
            </div>
        </div>

        <!-- 5 KPI Cards Utama -->
        <div class="kpi-grid">
            <div class="kpi-card">
                <h3><%= totalPasien %></h3>
                <p>Total Database Pasien</p>
            </div>
            <div class="kpi-card">
                <h3><%= totalKunjungan %></h3>
                <p>Total Kunjungan Medis</p>
            </div>
            <div class="kpi-card" style="border-top-color: #107c41;">
                <h3 style="color: #107c41;">Rp <%= totalPendapatan.toLocaleString('id-ID') %></h3>
                <p>Estimasi Omset Kasir</p>
            </div>
            <div class="kpi-card" style="border-top-color: #0284c7;">
                <h3 style="color: #0284c7;"><%= countSelesai %></h3>
                <p>Kunjungan Selesai</p>
            </div>
            <div class="kpi-card" style="border-top-color: #ef4444;">
                <h3 style="color: #ef4444;"><%= countBatal %></h3>
                <p>Kunjungan Batal / Cancel</p>
            </div>
        </div>

        <!-- Baris Atas: Trend Kunjungan & Status Antrean -->
        <div class="analytics-grid-top">
            <div class="chart-card">
                <h2 class="chart-title">📈 Trend Trafik Jumlah Kunjungan Pasien</h2>
                <p class="chart-subtitle">Kurva pertumbuhan volume kunjungan dari waktu ke waktu</p>
                <div style="height: 280px;">
                    <canvas id="trendChart"
                            data-labels='<%- JSON.stringify(Object.keys(monthlyData)) %>'
                            data-values='<%- JSON.stringify(Object.values(monthlyData)) %>'>
                    </canvas>
                </div>
            </div>

            <div class="chart-card">
                <h2 class="chart-title">🎯 Rasio Status Penyelesaian Kunjungan</h2>
                <p class="chart-subtitle">Perbandingan antrean Selesai vs Batal</p>
                <div style="height: 250px; display: flex; justify-content: center;">
                    <canvas id="statusChart"
                            data-selesai="<%= countSelesai %>"
                            data-batal="<%= countBatal %>">
                    </canvas>
                </div>
            </div>
        </div>

        <!-- Baris Bawah: Sebaran Alamat, Rasio Layanan, & Top Diagnosa -->
        <div class="analytics-grid-bottom">
            <div class="chart-card">
                <h2 class="chart-title">📍 Sebaran Wilayah / Alamat Pasien</h2>
                <p class="chart-subtitle">Demografi kuantitas asal tempat tinggal pasien</p>
                <div style="height: 260px;">
                    <canvas id="alamatChart"
                            data-labels='<%- JSON.stringify(Object.keys(alamatData)) %>'
                            data-values='<%- JSON.stringify(Object.values(alamatData)) %>'>
                    </canvas>
                </div>
            </div>

            <div class="chart-card">
                <h2 class="chart-title">🩺 Rasio Jenis Layanan</h2>
                <p class="chart-subtitle">Obstetri (ANC) vs Ginekologi (Promil/Kandungan)</p>
                <div style="height: 250px; display: flex; justify-content: center;">
                    <canvas id="layananChart"
                            data-obstetri="<%= countObstetri %>"
                            data-ginekologi="<%= countGinekologi %>">
                    </canvas>
                </div>
            </div>

            <div class="chart-card">
                <h2 class="chart-title">📋 Top Diagnosa Obgyn</h2>
                <p class="chart-subtitle">Frekuensi kasus diagnosa klinis terbanyak</p>
                <div style="height: 260px;">
                    <canvas id="diagnosaChart"
                            data-labels='<%- JSON.stringify(Object.keys(diagnosaData)) %>'
                            data-values='<%- JSON.stringify(Object.values(diagnosaData)) %>'>
                    </canvas>
                </div>
            </div>
        </div>

    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // 1. Line Chart Smooth Trend Kunjungan
            const trendCanvas = document.getElementById('trendChart');
            if (trendCanvas) {
                const labels = JSON.parse(trendCanvas.getAttribute('data-labels') || '[]');
                const values = JSON.parse(trendCanvas.getAttribute('data-values') || '[]');
                const ctx = trendCanvas.getContext('2d');
                
                const gradient = ctx.createLinearGradient(0, 0, 0, 280);
                gradient.addColorStop(0, 'rgba(13, 92, 117, 0.4)');
                gradient.addColorStop(1, 'rgba(13, 92, 117, 0.0)');

                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Volume Kunjungan',
                            data: values,
                            borderColor: '#0d5c75',
                            borderWidth: 3,
                            backgroundColor: gradient,
                            fill: true,
                            tension: 0.4,
                            pointBackgroundColor: '#c97c5d',
                            pointRadius: 5
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
                    }
                });
            }

            // 2. Status Antrean Doughnut Chart
            const statusCanvas = document.getElementById('statusChart');
            if (statusCanvas) {
                const selesai = parseInt(statusCanvas.getAttribute('data-selesai')) || 0;
                const batal = parseInt(statusCanvas.getAttribute('data-batal')) || 0;

                new Chart(statusCanvas.getContext('2d'), {
                    type: 'doughnut',
                    data: {
                        labels: ['Selesai Diperiksa', 'Batal / Cancel'],
                        datasets: [{
                            data: [selesai, batal],
                            backgroundColor: ['#0284c7', '#ef4444'],
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { position: 'bottom' } }
                    }
                });
            }

            // 3. Sebaran Alamat Bar Chart
            const alamatCanvas = document.getElementById('alamatChart');
            if (alamatCanvas) {
                const labels = JSON.parse(alamatCanvas.getAttribute('data-labels') || '[]');
                const values = JSON.parse(alamatCanvas.getAttribute('data-values') || '[]');

                new Chart(alamatCanvas.getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Jumlah Pasien',
                            data: values,
                            backgroundColor: 'rgba(201, 124, 93, 0.85)',
                            borderColor: '#c97c5d',
                            borderWidth: 1,
                            borderRadius: 6
                        }]
                    },
                    options: {
                        indexAxis: 'y',
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: { x: { beginAtZero: true, ticks: { stepSize: 1 } } }
                    }
                });
            }

            // 4. Rasio Layanan Doughnut Chart
            const layananCanvas = document.getElementById('layananChart');
            if (layananCanvas) {
                const obstetri = parseInt(layananCanvas.getAttribute('data-obstetri')) || 0;
                const ginekologi = parseInt(layananCanvas.getAttribute('data-ginekologi')) || 0;

                new Chart(layananCanvas.getContext('2d'), {
                    type: 'doughnut',
                    data: {
                        labels: ['Obstetri (ANC)', 'Ginekologi / Promil'],
                        datasets: [{
                            data: [obstetri, ginekologi],
                            backgroundColor: ['#0d5c75', '#c97c5d'],
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { position: 'bottom' } }
                    }
                });
            }

            // 5. Top Diagnosa Bar Chart
            const diagnosaCanvas = document.getElementById('diagnosaChart');
            if (diagnosaCanvas) {
                const labels = JSON.parse(diagnosaCanvas.getAttribute('data-labels') || '[]');
                const values = JSON.parse(diagnosaCanvas.getAttribute('data-values') || '[]');

                new Chart(diagnosaCanvas.getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Jumlah Kasus',
                            data: values,
                            backgroundColor: 'rgba(13, 92, 117, 0.85)',
                            borderColor: '#0d5c75',
                            borderWidth: 1,
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
                    }
                });
            }
        });
    </script>
</body>
</html>